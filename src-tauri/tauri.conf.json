{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "work-station",
  "version": "0.1.0",
  "identifier": "com.beqolozi.work-station",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "work-station",
        "width": 800,
        "height": 600,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:workstation.db"]
    },
    "updater": {
      "active": true,
      "pubkey": "RWTvL0uzeibRqFLGRiSSBX135TyaOw25IAl0tBHBksgc/yS/Am3/MU7H",
      "endpoints": [
        "https://github.com/BekaChkhiro/work-station/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
