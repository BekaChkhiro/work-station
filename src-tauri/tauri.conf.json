{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work Station",
  "version": "0.1.0",
  "identifier": "com.workstation.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Work Station",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:work-station.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1QzZCQTJGNzgzMDI3RTgKUldUb0p6QjRMN3JHMVRhY3R6VzVqQWxma3FZbXZqalM4a05ac0ZBSlpyV053cmIyUzU3ci9pV1gK",
      "endpoints": [
        "https://github.com/BekaChkhiro/work-station/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
